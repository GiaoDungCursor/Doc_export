<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.company.office.ui.TemplatesController"
      spacing="16.0">
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Quản lý Mẫu biểu (Templates &amp; Schemas)" styleClass="page-header"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="＋ Thêm dạng template" onAction="#onImportTemplate" styleClass="btn-primary"
                accessibleText="Thêm dạng template mới"/>
        <Button text="Mở thư mục mẫu" onAction="#onOpenTemplateFolder" styleClass="btn-secondary"
                accessibleText="Mở thư mục chứa template tùy chỉnh"/>
        <Button text="Quét lại" onAction="#onRescanTemplates" styleClass="btn-secondary"
                accessibleText="Quét lại thư mục template"/>
        <Button text="Xóa mẫu biểu" onAction="#onDeleteTemplate" styleClass="btn-danger"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="template-help-banner">
        <Label text="ⓘ" styleClass="template-help-icon"/>
        <VBox spacing="2.0">
            <Label text="Chọn file Word hoặc Excel; hệ thống sẽ quét vùng trống, bảng và placeholder."
                   styleClass="template-help-title"/>
            <Label text="Kiểm tra cột Nguồn dữ liệu, sửa mapping nếu cần rồi nhấn Lưu template để đưa vào Mẫu xuất."
                   styleClass="template-help-text"/>
        </VBox>
    </HBox>

    <TableView fx:id="templatesTable" prefHeight="260.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="Template ID" prefWidth="120.0"/>
            <TableColumn fx:id="colName" text="Tên mẫu biểu" prefWidth="250.0"/>
            <TableColumn fx:id="colType" text="Định dạng" prefWidth="100.0"/>
            <TableColumn fx:id="colPath" text="Đường dẫn file" prefWidth="350.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <VBox spacing="8.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <VBox spacing="2.0">
                <Label text="Placeholder và nguồn dữ liệu" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <Label text="Chọn một mẫu, quét cấu trúc rồi sửa trực tiếp cột Nguồn dữ liệu nếu cần."
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Quét &amp; map lại" onAction="#onScanAndMapSelected" styleClass="btn-secondary"/>
        </HBox>
        <TableView fx:id="mappingTable" prefHeight="220.0" editable="true">
            <columns>
                <TableColumn fx:id="colTarget" text="Placeholder đích" prefWidth="190.0"/>
                <TableColumn fx:id="colSource" text="Nguồn dữ liệu" prefWidth="260.0"/>
                <TableColumn fx:id="colOrigin" text="Nguồn mapping" prefWidth="120.0"/>
                <TableColumn fx:id="colConfidence" text="Tin cậy" prefWidth="90.0"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
        <TitledPane text="Nâng cao: Schema JSON" expanded="false" animated="false">
            <TextArea fx:id="schemaJsonArea" prefHeight="180.0" editable="true" wrapText="true"/>
        </TitledPane>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <Label text="Kiểm tra mappings trước khi duyệt" style="-fx-text-fill: #64748b;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Lưu template" onAction="#onApproveSchema" styleClass="btn-success"/>
        </HBox>
        <Label fx:id="statusLabel" text="Sẵn sàng" style="-fx-font-size: 11px; -fx-text-fill: #a5b4fc;"/>
    </VBox>
</VBox>
